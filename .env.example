# Copy this file to .env and fill it in. .env itself is gitignored — never
# commit real credentials.
#
# The app never creates a database or a database user for you. For
# DB_DRIVER=mysql, create the database and user yourself first (see
# database/MIGRATION_MYSQL.md for the exact SQL) and only then fill in the
# values below.

# Which database engine to use: "sqlite" (default, no setup needed) or
# "mysql" (also covers MariaDB).
DB_DRIVER=sqlite

# --- SQLite (used only when DB_DRIVER=sqlite) ---
# Path to the SQLite file, relative to the project root (or an absolute path).
DB_SQLITE_PATH=db/payment_control.sqlite

# --- MySQL / MariaDB (used only when DB_DRIVER=mysql) ---
# The database named here must already exist — the app only creates tables
# inside it, never the database itself.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4
